#!/usr/bin/env bash
set -uo pipefail

URL="${IDENTITY_ROLLBACK_URL:-}"
REQUIRED="${IDENTITY_ROLLBACK_REQUIRED:-0}"

if [ -z "$URL" ]; then
  echo "skip: IDENTITY_ROLLBACK_URL is not set, so the rollback was not exercised" >&2
  echo "      (set it to any PostgreSQL server this user may create databases on;" >&2
  echo "       IDENTITY_ROLLBACK_REQUIRED=1 turns this skip into a red)" >&2
  if [ "$REQUIRED" = "1" ]; then
    echo "bin/rollback: IDENTITY_ROLLBACK_REQUIRED=1 and there is no server to check against" >&2
    exit 3
  fi
  exit 0
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MIGRATIONS=("$ROOT"/migrations/[0-9]*.sql)
COUNT="${#MIGRATIONS[@]}"

DB="identity_rollback_check"

CALLER="${URL#*://}"
CALLER="${CALLER%%@*}"
CALLER="${CALLER%%:*}"
APP_ROLE="${CALLER}_app"

SCRATCH="${URL%/*}/$DB"
DB_URL="$SCRATCH"

created_app_role=0

provision() {
  local out
  out="$(psql "$URL" -X -q -t -A --no-psqlrc --set ON_ERROR_STOP=1 \
          -c "select 1 from pg_roles where rolname = '$APP_ROLE' and rolcanlogin" 2>&1)" || {
    echo "bin/rollback: could not ask the cluster about the $APP_ROLE role: $out" >&2
    exit 3
  }
  if [ "$(printf '%s' "$out" | tr -d '[:space:]')" = "1" ]; then
    echo "rollback: reusing the cluster's existing $APP_ROLE login role"
    return 0
  fi
  out="$(scratch_sql "create role \"$APP_ROLE\" login password '$FIXTURE_PASSWORD'" 2>&1)" \
    || { echo "bin/rollback: could not create the $APP_ROLE role: $out" >&2
         echo "              (the caller needs CREATEROLE — a fleet cluster's service role has it," >&2
         echo "               or docker compose's cluster already provides it)" >&2
         exit 3; }
  created_app_role=1
}

FIXTURE_PASSWORD="rollback_check"

scratch() { psql "$SCRATCH" "$@"; }

if ! psql "$URL" -X -q --no-psqlrc -c "select 1" >/dev/null 2>&1; then
  echo "bin/rollback: cannot reach the server at $URL" >&2
  exit 3
fi

scratch_sql() { psql "$URL" -X -q --no-psqlrc --set ON_ERROR_STOP=1 -c "$1"; }

scratch_sql "drop database if exists \"$DB\"" || {
  echo "bin/rollback: could not drop a previous scratch database" >&2
  exit 3
}
scratch_sql "create database \"$DB\"" || {
  echo "bin/rollback: could not create the scratch database (does this user hold CREATEDB?)" >&2
  exit 3
}

provision
cleanup() {
  psql "$URL" -X -q --no-psqlrc -c "drop database if exists \"$DB\"" >/dev/null 2>&1 || true
  if [ "$created_app_role" = "1" ]; then
    psql "$URL" -X -q --no-psqlrc -c "drop role if exists \"$APP_ROLE\"" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

census() {
  scratch -X -t -A --no-psqlrc -c "
    with live as (
      select n.nspname
        from pg_namespace n
       where n.nspname not in ('pg_catalog','information_schema','pg_toast')
         and n.nspname not like 'pg_temp_%'
         and n.nspname not like 'pg_toast_temp_%'
    )
    select what || ' ' || name from (
      select 'table'    as what, c.relname as name from pg_class c
        join pg_namespace n on n.oid = c.relnamespace
        join live l on l.nspname = n.nspname
       where c.relkind = 'r'
      union all
      select 'view', c.relname from pg_class c
        join pg_namespace n on n.oid = c.relnamespace
        join live l on l.nspname = n.nspname
       where c.relkind in ('v','m')
      union all
      select 'sequence', s.relname from pg_class s
        join pg_namespace n on n.oid = s.relnamespace
        join live l on l.nspname = n.nspname
       where s.relkind = 'S'
      union all
      select 'type', t.typname from pg_type t
        join pg_namespace n on n.oid = t.typnamespace
        join live l on l.nspname = n.nspname
       where t.typtype in ('e','c','d','r','m')
      union all
      select 'function', p.oid::regprocedure::text from pg_proc p
        join pg_namespace n on n.oid = p.pronamespace
        join live l on l.nspname = n.nspname
      union all
      select 'trigger', t.tgname from pg_trigger t
        join pg_class c on c.oid = t.tgrelid
        join pg_namespace n on n.oid = c.relnamespace
        join live l on l.nspname = n.nspname
       where not t.tgisinternal
      union all
      select 'policy', pol.polname from pg_policy pol
        join pg_class c on c.oid = pol.polrelid
        join pg_namespace n on n.oid = c.relnamespace
        join live l on l.nspname = n.nspname
      union all
      select 'index', i.relname from pg_class i
        join pg_index x on x.indexrelid = i.oid
        join pg_class c on c.oid = x.indrelid
        join pg_namespace n on n.oid = c.relnamespace
        join live l on l.nspname = n.nspname
      union all
      select 'column', a.attname from pg_attribute a
        join pg_class c on c.oid = a.attrelid
        join pg_namespace n on n.oid = c.relnamespace
        join live l on l.nspname = n.nspname
       where a.attnum > 0 and not a.attisdropped
    ) s order by 1;"
}

apply() {
  local half="$1" file="$2"
  if [ "$half" = up ]; then
    "$ROOT/bin/migration-up-section" "$file"
  else
    "$ROOT/bin/migration-down-section" "$file"
  fi | scratch -X -q --set ON_ERROR_STOP=1 --no-psqlrc
}

echo "rollback: $COUNT migrations, one Down at a time, against ${URL%%\?*}"

A_PREV="$(census)"
failures=0
applied=0

for migration in "${MIGRATIONS[@]}"; do
  name="$(basename "$migration")"

  if ! apply up "$migration"; then
    echo "FAIL  $name: the UP section does not apply" >&2
    failures=$((failures + 1))
    break
  fi
  applied=$((applied + 1))
  A_THIS="$(census)"

  if ! grep -qE '^--[[:space:]]*\+goose[[:space:]]+Down' "$migration"; then
    echo "FAIL  $name: has NO -- +goose Down marker — a deploy nobody can undo" >&2
    failures=$((failures + 1))
    break
  fi
  down_body="$("$ROOT/bin/migration-down-section" "$migration")"
  if ! out="$(printf '%s\n' "$down_body" | scratch -X -q --set ON_ERROR_STOP=1 --no-psqlrc 2>&1)"; then
    echo "FAIL  $name: the DOWN section errors" >&2
    printf '%s\n' "$out" | grep -E 'ERROR' | head -3 | sed 's/^/        /'
    failures=$((failures + 1))
    break
  fi
  C_THIS="$(census)"

  if [ "$C_THIS" != "$A_PREV" ]; then
    echo "FAIL  $name: the schema after its Down is not the schema its Up found" >&2
    diff <(printf '%s\n' "$A_PREV") <(printf '%s\n' "$C_THIS") \
      | grep -E '^[<>]' | head -12 | sed 's/^/        /'
    failures=$((failures + 1))
    break
  fi

  if ! apply up "$migration"; then
    echo "FAIL  $name: does not re-apply after its own rollback — the rollback-then-redeploy path is broken" >&2
    failures=$((failures + 1))
    break
  fi

  A_PREV="$A_THIS"
done

if [ "$failures" -eq 0 ]; then
  echo "rollback: $applied migrations, each rolled back and re-applied with zero leftovers"
else
  echo "rollback: $failures failure(s) — see the named migrations above"
fi

if [ "$failures" -eq 0 ]; then exit 0; else exit 1; fi
