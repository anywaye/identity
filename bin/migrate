#!/usr/bin/env bash
set -euo pipefail

DATABASE_URL="${DATABASE_URL:-}"
if [ -z "$DATABASE_URL" ]; then
  echo "bin/migrate: DATABASE_URL is not set; there is nothing to migrate" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

for migration in "$ROOT"/migrations/*.sql; do
  [ -e "$migration" ] || continue
  name="$(basename "$migration")"
  printf 'applying %s\n' "$name"
  if ! "$ROOT/bin/migration-up-section" "$migration" \
    | psql "$DATABASE_URL" --quiet --variable ON_ERROR_STOP=1; then
    echo "bin/migrate: $name failed; the database is at whatever the previous file left it" >&2
    echo "bin/migrate: fix it by hand, or use 'goose -dir migrations postgres \$DATABASE_URL up'" >&2
    exit 1
  fi
done

printf 'migrations applied\n'
