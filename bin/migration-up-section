#!/usr/bin/env bash

set -uo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: bin/migration-up-section <migration.sql>" >&2
  exit 2
fi

migration="$1"
if [ ! -r "$migration" ]; then
  echo "bin/migration-up-section: $migration is not readable" >&2
  exit 2
fi

awk '/^--[[:space:]]*\+goose[[:space:]]+Down/ { exit } { print }' "$migration"